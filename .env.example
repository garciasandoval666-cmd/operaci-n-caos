# ============================================================
# ConectaEventos · variables de entorno
# Copia este archivo como .env y ajusta tus credenciales.
# ============================================================

APP_NAME="ConectaEventos"
APP_ENV=local
# true solo en desarrollo local; nunca en producción
APP_DEBUG=false
APP_URL=http://localhost/WTC

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=conectaeventos
DB_USERNAME=root
DB_PASSWORD=

# Zona horaria y moneda
APP_TIMEZONE=America/Mexico_City
APP_MONEDA=MXN
